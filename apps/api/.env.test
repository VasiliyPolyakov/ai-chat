# Нечутливі значення для тестів (файл комітиться; машинерія курсу).
# test/setup/load-env.ts читає цей файл до старту тестів і підставляє DATABASE_URL=$DATABASE_URL_TEST,
# тож тести ніколи не ходять у dev-базу. Змінні, вже задані в оточенні (наприклад, у CI), мають пріоритет.

APP_ENV=test
# Сервіс db-test з infra/compose.dev.yml (tmpfs, порт 5433) або service container у CI
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/chat_test
