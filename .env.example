# Приклад конфігурації для локальної розробки (L01).
# Скопіюй у apps/api/.env (cp .env.example apps/api/.env; він у .gitignore) — npm run dev запускає api з теки apps/api.
# Тут немає секретів: лише локальні значення за замовчуванням.

# development | test | ci | production — єдине джерело політик застосунку
APP_ENV=development
# Порт HTTP-сервера Nest
PORT=3000
# Версія, яку повертає /api/health (у CI/проді — SHA коміту)
APP_VERSION=dev
# Postgres для розробки (сервіс db з infra/compose.dev.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat_dev
